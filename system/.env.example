# policymap 환경설정 예시 — 이 파일을 system/.env 로 복사해 값을 채운다.
# .env 는 .gitignore 로 차단돼 있다. 절대 커밋하지 말 것.
#
# ★ 중요 ★ 이미 수집된 DB로 시각화만 볼 때는 이 키들이 필요 없다.
#          키는 데이터를 새로 수집·갱신할 때만 쓴다.
#
# 발급 절차는 docs/11_API키_발급가이드.md 참조.

# 국가법령정보 Open API — OC 는 신청 이메일의 ID 부분
# https://open.law.go.kr
LAW_OC=

# 열린국회정보 API 인증키 (32자 hex)
# https://open.assembly.go.kr
ASSEMBLY_KEY=

# V-World 데이터 API 키 (개발키는 도메인 종속)
# https://www.vworld.kr
VWORLD_KEY=
VWORLD_DOMAIN=http://localhost

# 지방재정365 세부사업별 세출현황
# https://lofin365.go.kr
LOFIN_KEY=

# 행정안전부 행정표준코드 StanReginCd (공공데이터포털)
# https://www.data.go.kr — 디코딩 키를 넣는다(HTTP 클라이언트가 인코딩 담당)
STANREGIN_KEY=
# 인코딩 키가 따로 필요한 경우에만
STANREGIN_KEY_ENC=

# Gemini — AI 정책분석관 챗봇용. viz/serve_ai.py 프록시만 읽고 브라우저에는 전달되지 않는다.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

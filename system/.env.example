# policy_maps 환경설정 예시 — 이 파일을 .env 로 복사해 값을 채운다.
# 로드 우선순위: os.environ > .env > 기본값 (policymap/config.py).
# GitHub Actions 에서는 secrets/vars 로 주입한다(.github/workflows/refresh.yml 참조).

# ── 국가법령정보 Open API (open.law.go.kr / www.law.go.kr/DRF) ──────────────
# OC = 신청 이메일의 ID 부분 (예: g4c@korea.kr → LAW_OC=g4c). 운영키는 IP/도메인 등록 필수.
# 개발 검증용으로 test 키가 현재 동작(실운영 전 자체 발급 권장).
LAW_OC=test
# LAW_BASE=https://www.law.go.kr/DRF

# ── 열린국회정보 (open.assembly.go.kr/portal/openapi) ────────────────────────
# 실키 발급 필요. 미발급 시 sample 처리로 10건만 반환(ERROR-290).
ASSEMBLY_KEY=
# ASSEMBLY_BASE=https://open.assembly.go.kr/portal/openapi

# ── V-World 데이터 API (api.vworld.kr/req/data) ──────────────────────────────
# 인증키는 도메인 종속. 서버 호출 시 VWORLD_DOMAIN 이 등록 도메인과 일치해야 함.
VWORLD_KEY=
VWORLD_DOMAIN=http://localhost
# VWORLD_BASE=https://api.vworld.kr/req/data

# ── 지방재정365 세부사업별 세출현황 (lofin365.go.kr/lf/hub/QWGJK) ────────────
# 인증키 신청형(요청제한 없음). 파라미터명(Key vs serviceKey)은 실키로 확정 필요.
LOFIN_KEY=
# LOFIN_BASE=https://www.lofin365.go.kr/lf/hub

# ── 행정표준코드 StanReginCd (apis.data.go.kr/1741000/StanReginCd) ───────────
# 공공데이터포털 인증키. 법정동코드 10자리 스파인 확보용. 개발계정 10,000건/일.
STANREGIN_KEY=
# STANREGIN_BASE=https://apis.data.go.kr/1741000/StanReginCd

# ── 저장/실행 경로 ───────────────────────────────────────────────────────────
# POLICYMAP_DB=F:/policy_maps/system/data/policymap.db
# POLICYMAP_OUT=F:/policy_maps/system/data
# POLICYMAP_SCHEMA=F:/policy_maps/system/db/schema.sql

# ── 네트워크 튜닝 ────────────────────────────────────────────────────────────
# HTTP_TIMEOUT=40
# HTTP_RETRIES=3
# HTTP_BACKOFF_BASE=0.8
# POLICYMAP_CONCURRENCY=6
# POLICYMAP_ERROR_BUDGET=0.05
# POLICYMAP_RATE_QPS=5
# POLICYMAP_LOG_LEVEL=INFO

# ── 발표용 AI 정책분석관 (viz/serve_ai.py) ────────────────────────────────
# 브라우저에 직접 넣지 않는다. 로컬 프록시 서버가 이 값을 읽어 Gemini API 를 호출한다.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

def _add_member_of(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,
                    "SELECT legislator_id, current_party FROM legislators "
                    "WHERE current_party IS NOT NULL"):
        u = node_id("legislator", r["legislator_id"])
        v = node_id("party", r["current_party"])

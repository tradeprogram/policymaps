"""policymap.graph.build — SQLite → 그래프(노드/엣지) 빌드.

CONTRACTS.md §3.1 계약:
    build_graph(conn) -> "Graph"
    node_id(kind, key) -> str        # 'region:26110' 접두 규약

설계 규율:
  * networkx 있으면 nx.MultiDiGraph, 없으면 순수파이썬 _FallbackGraph(동형 최소 표면).
  * 노드: Region/LegalInstrument/Ordinance/Bill/Legislator/Party/Category/BudgetLine/Article.
  * 엣지: HAS_ORDINANCE/DELEGATED_FROM/SUBORDINATE_TO/CITES(+instrument_relations 계열)/
          ADJACENT_TO/SUCCEEDED_BY/CONTAINS/SIMILAR_TO/IN_CATEGORY/FUNDED_BY/
          PROPOSED_BY/VOTED/MEMBER_OF/ENACTS.
  * 엣지 양끝 노드가 없으면 스킵(dangling 방지) + graph 메타에 skipped 카운트 기록.
  * 접근자 graph_nodes/graph_edges/graph_meta 로 두 그래프 타입을 통일 취급
    (analysis.py, export.py 가 networkx 유무와 무관하게 이 헬퍼만 사용).

무거운 의존성 없이 코어 표준라이브러리로 동작한다.
"""
from __future__ import annotations

import sqlite3
from typing import Any, Iterable, Iterator, Optional

from .. import db as _db

try:  # 선택적 가속: networkx
    import networkx as _nx  # type: ignore
    _HAS_NX = True
except Exception:  # pragma: no cover - 폴백 경로
    _nx = None  # type: ignore
    _HAS_NX = False


# --------------------------------------------------------------------------- #
# 노드 ID 접두 규약
# --------------------------------------------------------------------------- #
# kind(도메인 라벨) -> 노드키 접두. constitution 은 instrument 네임스페이스로 흡수.
_PREFIX = {
    "region": "region",
    "instrument": "instrument",
    "constitution": "instrument",
    "ordinance": "ordinance",
    "bill": "bill",
    "legislator": "legislator",
    "party": "party",
    "category": "category",
    "budget": "budget",
    "article": "article",
}

# 노드 라벨(도메인 kind → 그래프 라벨 속성 값)
_LABEL = {
    "region": "Region",
    "instrument": "LegalInstrument",
    "ordinance": "Ordinance",
    "bill": "Bill",
    "legislator": "Legislator",
    "party": "Party",
    "category": "Category",
    "budget": "BudgetLine",
    "article": "Article",
}


def node_id(kind: str, key: str) -> str:
    """도메인 kind + 자연키 → 네임스페이스 노드 ID. 예: node_id('region','26110')='region:26110'.

    instrument_id/ordinance_id 처럼 이미 접두가 있는 자연키도 kind 접두로 한 번 더 감싸
    노드키를 결정적·충돌없이 만든다(예: 'instrument:statute:12345').
    """
    prefix = _PREFIX.get(kind, kind)
    return f"{prefix}:{key}"


# --------------------------------------------------------------------------- #
# 폴백 그래프 (networkx 부재 시)
# --------------------------------------------------------------------------- #
class _FallbackGraph:
    """networkx.MultiDiGraph 의 최소 부분집합. 방향 다중그래프.

    analysis/export 는 build.graph_nodes/graph_edges 접근자를 통해서만 순회하므로
    이 클래스는 add_node/add_edge/has_node 와 순회 소스만 제공하면 충분하다.
    """

    def __init__(self) -> None:
        self._nodes: dict[str, dict[str, Any]] = {}
        self._adj: dict[str, list[tuple[str, Any, dict[str, Any]]]] = {}
        self._edge_count = 0
        self.graph: dict[str, Any] = {}  # networkx 와 동형인 그래프 메타 컨테이너

    # --- 변경 ---
    def add_node(self, n: str, **attrs: Any) -> None:
        if n in self._nodes:
            if attrs:
                self._nodes[n].update(attrs)
        else:
            self._nodes[n] = dict(attrs)
            self._adj.setdefault(n, [])

    def add_edge(self, u: str, v: str, key: Any = None, **attrs: Any) -> None:
        if u not in self._nodes:
            self.add_node(u)
        if v not in self._nodes:
            self.add_node(v)
        self._adj[u].append((v, key, dict(attrs)))
        self._edge_count += 1

    # --- 조회 ---
    def has_node(self, n: str) -> bool:
        return n in self._nodes

    def __contains__(self, n: str) -> bool:
        return n in self._nodes

    def number_of_nodes(self) -> int:
        return len(self._nodes)

    def number_of_edges(self) -> int:
        return self._edge_count

    # --- 순회 소스(접근자 헬퍼 전용) ---
    def nodes_data(self) -> Iterable[tuple[str, dict[str, Any]]]:
        return self._nodes.items()

    def edges_data(self) -> Iterator[tuple[str, str, Any, dict[str, Any]]]:
        for u, lst in self._adj.items():
            for (v, key, attr) in lst:
                yield (u, v, key, attr)


# 타입 별칭(반환 애노테이션 "Graph")
Graph = Any


def new_graph() -> Graph:
    """빈 그래프 생성(networkx 우선, 없으면 폴백)."""
    if _HAS_NX:
        g = _nx.MultiDiGraph()
        return g
    return _FallbackGraph()


# --------------------------------------------------------------------------- #
# 두 그래프 타입 통일 접근자
# --------------------------------------------------------------------------- #
def _is_fallback(G: Graph) -> bool:
    return hasattr(G, "nodes_data")


def graph_nodes(G: Graph) -> list[tuple[str, dict[str, Any]]]:
    """(node_id, attr_dict) 리스트. networkx/폴백 공통."""
    if _is_fallback(G):
        return list(G.nodes_data())
    return list(G.nodes(data=True))


def graph_edges(G: Graph) -> list[tuple[str, str, Any, dict[str, Any]]]:
    """(u, v, key, attr_dict) 리스트. networkx/폴백 공통."""
    if _is_fallback(G):
        return list(G.edges_data())
    return [(u, v, k, d) for u, v, k, d in G.edges(keys=True, data=True)]


def graph_meta(G: Graph) -> dict[str, Any]:
    """그래프 레벨 메타 dict(빌드 통계 등). networkx 는 G.graph, 폴백도 .graph."""
    return getattr(G, "graph", {})


# --------------------------------------------------------------------------- #
# 내부: 안전 노드 추가
# --------------------------------------------------------------------------- #
def _clean_attrs(row: dict[str, Any], keys: Iterable[str], *, extra: Optional[dict] = None) -> dict:
    """row 에서 지정 키만 스칼라로 추려 노드/엣지 속성 dict 생성(None 은 제거)."""
    out: dict[str, Any] = {}
    for k in keys:
        v = row.get(k)
        if v is not None:
            out[k] = v
    if extra:
        out.update({k: v for k, v in extra.items() if v is not None})
    return out


def _fetch(conn: sqlite3.Connection, sql: str, params: Iterable[Any] = ()) -> list[dict]:
    """테이블이 없거나 비어도 안전하게 list[dict] 반환."""
    try:
        return _db.fetchall(conn, sql, params)
    except sqlite3.OperationalError:
        return []


# --------------------------------------------------------------------------- #
# 노드 로더
# --------------------------------------------------------------------------- #
def _add_regions(conn, G) -> int:
    n = 0
    for r in _fetch(conn,
                    "SELECT region_id, region_cd, sig_cd, name, full_name, level, "
                    "parent_region, has_legislation, lofin_laf_cd, population, status, "
                    "valid_from, valid_to FROM regions"):
        nid = node_id("region", r["region_id"])
        G.add_node(nid, **_clean_attrs(
            r, ("name", "full_name", "level", "sig_cd", "has_legislation",
                "population", "status", "valid_to"),
            extra={"label": _LABEL["region"], "kind": "region", "src_id": r["region_id"]}))
        n += 1
    return n


def _add_instruments(conn, G) -> int:
    n = 0
    for r in _fetch(conn,
                    "SELECT instrument_id, kind, source_type, national_tier, name, "
                    "competent_authority, status, current_history, effective_on, "
                    "verification_status FROM legal_instrument"):
        nid = node_id("instrument", r["instrument_id"])
        G.add_node(nid, **_clean_attrs(
            r, ("name", "source_type", "national_tier", "competent_authority",
                "status", "current_history", "effective_on", "verification_status"),
            extra={"label": _LABEL["instrument"], "kind": "instrument",
                   "instrument_kind": r.get("kind"), "src_id": r["instrument_id"]}))
        n += 1
    return n


def _add_ordinances(conn, G) -> int:
    n = 0
    for r in _fetch(conn,
                    "SELECT ordinance_id, mst, region_id, org_name, name, ord_kind, "
                    "local_tier, delegation_type, department, enacted_on, effective_on, "
                    "repealed_on, rr_cls_cd, article_count, status, verification_status "
                    "FROM ordinances"):
        nid = node_id("ordinance", r["ordinance_id"])
        G.add_node(nid, **_clean_attrs(
            # repealed_on 을 실어야 그래프 단에서 정책 생애주기(제정→폐지)를 볼 수 있다.
            # 폐지 자치법규 40,406건이 노드로 들어오므로 status 만으로는 시점을 알 수 없다.
            r, ("name", "org_name", "ord_kind", "local_tier", "delegation_type",
                "department", "enacted_on", "effective_on", "repealed_on", "rr_cls_cd",
                "article_count", "status", "verification_status"),
            extra={"label": _LABEL["ordinance"], "kind": "ordinance",
                   "region_id": r.get("region_id"), "src_id": r["ordinance_id"]}))
        n += 1
    return n


def _add_bills(conn, G) -> int:
    n = 0
    for r in _fetch(conn,
                    "SELECT bill_id, bill_no, age, name, committee, propose_dt, "
                    "proc_dt, proc_result, proc_result_cd, yes_tcnt, no_tcnt, "
                    "blank_tcnt FROM bills"):
        nid = node_id("bill", r["bill_id"])
        G.add_node(nid, **_clean_attrs(
            r, ("name", "bill_no", "age", "committee", "propose_dt", "proc_dt",
                "proc_result", "proc_result_cd", "yes_tcnt", "no_tcnt", "blank_tcnt"),
            extra={"label": _LABEL["bill"], "kind": "bill", "src_id": r["bill_id"]}))
        n += 1
    return n


def _add_legislators(conn, G) -> int:
    n = 0
    for r in _fetch(conn,
                    "SELECT legislator_id, name, current_party, district, elect_type, "
                    "units, sex FROM legislators"):
        nid = node_id("legislator", r["legislator_id"])
        G.add_node(nid, **_clean_attrs(
            r, ("name", "district", "elect_type", "units", "sex"),
            extra={"label": _LABEL["legislator"], "kind": "legislator",
                   "current_party": r.get("current_party"), "src_id": r["legislator_id"]}))
        n += 1
    return n


def _add_parties(conn, G) -> int:
    n = 0
    for r in _fetch(conn, "SELECT party_id, name, poly_cd FROM parties"):
        nid = node_id("party", r["party_id"])
        G.add_node(nid, **_clean_attrs(
            r, ("name", "poly_cd"),
            extra={"label": _LABEL["party"], "kind": "party", "src_id": r["party_id"]}))
        n += 1
    return n


def _add_categories(conn, G) -> int:
    n = 0
    for r in _fetch(conn, "SELECT code, name, level, parent_code FROM categories"):
        nid = node_id("category", r["code"])
        G.add_node(nid, **_clean_attrs(
            r, ("name", "level", "parent_code"),
            extra={"label": _LABEL["category"], "kind": "category", "src_id": r["code"]}))

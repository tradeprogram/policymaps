def _add_enacts(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,
                    "SELECT bill_id, enacted_instrument_id, enact_match_method "
                    "FROM bills WHERE enacted_instrument_id IS NOT NULL"):
        u = node_id("bill", r["bill_id"])
        v = node_id("instrument", r["enacted_instrument_id"])
        if _add_edge_safe(G, u, v, "ENACTS",
                          _clean_attrs(r, ("enact_match_method",)), skipped):
            c += 1
    return c


# --------------------------------------------------------------------------- #
# 공개: build_graph
# --------------------------------------------------------------------------- #
def build_graph(
    conn: sqlite3.Connection,
    *,
    include_articles: bool = False,
    include_similarity: bool = True,
    include_votes: bool = True,
) -> Graph:
    """SQLite → 그래프. networkx 있으면 MultiDiGraph, 없으면 _FallbackGraph.

    옵션:
      include_articles : Article 노드/HAS_ARTICLE 포함(대용량 → 기본 False).
      include_similarity: SIMILAR_TO 엣지 포함(기본 True).
      include_votes    : VOTED 엣지 포함(기본 True).

    반환 그래프의 graph 메타(graph_meta)에 노드/엣지/스킵 통계를 기록한다.
    """
    G = new_graph()
    node_counts: dict[str, int] = {}
    edge_counts: dict[str, int] = {}
    skipped: dict[str, int] = {}

    # --- 노드 ---
    node_counts["Region"] = _add_regions(conn, G)
    node_counts["LegalInstrument"] = _add_instruments(conn, G)
    node_counts["Ordinance"] = _add_ordinances(conn, G)
    node_counts["Bill"] = _add_bills(conn, G)
    node_counts["Legislator"] = _add_legislators(conn, G)
    node_counts["Party"] = _add_parties(conn, G)
    node_counts["Category"] = _add_categories(conn, G)
    node_counts["BudgetLine"] = _add_budget_lines(conn, G)
    if include_articles:
        node_counts["Article"] = _add_articles(conn, G)

    # --- 엣지 ---
    edge_counts["HAS_ORDINANCE"] = _add_has_ordinance(conn, G, skipped)
    edge_counts["DELEGATED_FROM/SUBORDINATE_TO"] = _add_delegations(conn, G, skipped)
    edge_counts["CITES(+relations)"] = _add_instrument_relations(conn, G, skipped)
    edge_counts["ADJACENT_TO"] = _add_adjacency(conn, G, skipped)
    edge_counts["SUCCEEDED_BY"] = _add_succession(conn, G, skipped)
    edge_counts["CONTAINS"] = _add_contains(conn, G, skipped)
    if include_similarity:
        edge_counts["SIMILAR_TO"] = _add_similarity(conn, G, skipped)
    edge_counts["IN_CATEGORY"] = _add_in_category(conn, G, skipped)
    edge_counts["FUNDED_BY"] = _add_funded_by(conn, G, skipped)
    edge_counts["PROPOSED_BY"] = _add_proposed_by(conn, G, skipped)
    if include_votes:
        edge_counts["VOTED"] = _add_voted(conn, G, skipped)
    edge_counts["MEMBER_OF"] = _add_member_of(conn, G, skipped)
    edge_counts["ENACTS"] = _add_enacts(conn, G, skipped)

    meta = graph_meta(G)
    meta["backend"] = "networkx" if (_HAS_NX and not _is_fallback(G)) else "fallback"
    meta["node_counts"] = node_counts
    meta["edge_counts"] = edge_counts
    meta["skipped_edges"] = {k: v for k, v in skipped.items() if v}
    meta["total_nodes"] = G.number_of_nodes()
    meta["total_edges"] = G.number_of_edges()
    return G


__all__ = [
    "build_graph", "node_id", "new_graph",
    "graph_nodes", "graph_edges", "graph_meta",
    "Graph",
]

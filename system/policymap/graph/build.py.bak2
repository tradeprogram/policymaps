    return n


def _add_budget_lines(conn, G) -> int:
    n = 0
    for r in _fetch(conn,
                    "SELECT budget_id, fyr, laf_cd, region_id, dbiz_cd, dbiz_nm, "
                    "field, sector, budget_now, exe_amt FROM budget_lines"):
        nid = node_id("budget", r["budget_id"])
        G.add_node(nid, **_clean_attrs(
            r, ("fyr", "laf_cd", "dbiz_cd", "field", "sector", "budget_now", "exe_amt"),
            extra={"label": _LABEL["budget"], "kind": "budget",
                   "name": r.get("dbiz_nm"), "region_id": r.get("region_id"),
                   "src_id": r["budget_id"]}))
        n += 1
    return n


def _add_articles(conn, G) -> int:
    """국가법령 조문 + 자치법규 조문 → Article 노드(대용량 → 기본 비활성)."""
    n = 0
    for r in _fetch(conn,
                    "SELECT article_id, instrument_id, article_no, title FROM articles"):
        nid = node_id("article", r["article_id"])
        G.add_node(nid, **_clean_attrs(
            r, ("article_no", "title"),
            extra={"label": _LABEL["article"], "kind": "article",
                   "parent": node_id("instrument", r["instrument_id"]) if r.get("instrument_id") else None,
                   "src_id": r["article_id"]}))
        n += 1
    for r in _fetch(conn,
                    "SELECT oa_id, ordinance_id, article_no, title FROM ordinance_articles"):
        nid = node_id("article", r["oa_id"])
        G.add_node(nid, **_clean_attrs(
            r, ("article_no", "title"),
            extra={"label": _LABEL["article"], "kind": "article",
                   "parent": node_id("ordinance", r["ordinance_id"]) if r.get("ordinance_id") else None,
                   "src_id": r["oa_id"]}))
        n += 1
    return n


# --------------------------------------------------------------------------- #
# 엣지 로더 (양끝 노드 존재 시에만 연결)
# --------------------------------------------------------------------------- #
def _add_edge_safe(G, u, v, relation, attrs, skipped: dict) -> bool:
    if (u in G) and (v in G):
        G.add_edge(u, v, key=relation, relation=relation, **attrs)
        return True
    skipped[relation] = skipped.get(relation, 0) + 1
    return False


def _map_child_node(kind: str, ident: str) -> str:
    return node_id("ordinance", ident) if kind == "ordinance" else node_id("instrument", ident)


def _map_parent_node(kind: str, ident: str) -> str:
    if kind == "ordinance":
        return node_id("ordinance", ident)
    # 'instrument' | 'constitution' → instrument 네임스페이스
    return node_id("instrument", ident)


def _add_has_ordinance(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,
                    "SELECT region_id, ordinance_id, ord_kind FROM ordinances "
                    "WHERE region_id IS NOT NULL"):
        u = node_id("region", r["region_id"])
        v = node_id("ordinance", r["ordinance_id"])
        if _add_edge_safe(G, u, v, "HAS_ORDINANCE",
                          _clean_attrs(r, ("ord_kind",)), skipped):
            c += 1
    return c


def _add_delegations(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,
                    "SELECT child_kind, child_id, parent_kind, parent_id, relation, "
                    "delegation_type, source_path, inferred, tier_gap "
                    "FROM delegations"):
        u = _map_child_node(r["child_kind"], r["child_id"])
        v = _map_parent_node(r["parent_kind"], r["parent_id"])
        rel = r["relation"] or "DELEGATED_FROM"
        if _add_edge_safe(G, u, v, rel,
                          _clean_attrs(r, ("delegation_type", "source_path",
                                           "inferred", "tier_gap")), skipped):
            c += 1
    return c


def _add_instrument_relations(conn, G, skipped) -> int:
    """CITES/INCORPORATES_STANDARD/PREVAILS_OVER/AMENDED_BY 계열(instrument_relations)."""
    c = 0
    for r in _fetch(conn,
                    "SELECT src_kind, src_id, dst_kind, dst_id, relation, "
                    "citation_type, priority_rule FROM instrument_relations"):
        u = _map_child_node(r["src_kind"], r["src_id"])
        v = _map_child_node(r["dst_kind"], r["dst_id"])
        rel = r["relation"] or "CITES"
        if _add_edge_safe(G, u, v, rel,
                          _clean_attrs(r, ("citation_type", "priority_rule")), skipped):
            c += 1
    return c


def _add_adjacency(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,
                    "SELECT region_id, neighbor_id, contiguity_type, same_province "
                    "FROM region_adjacency"):
        u = node_id("region", r["region_id"])
        v = node_id("region", r["neighbor_id"])
        if _add_edge_safe(G, u, v, "ADJACENT_TO",
                          _clean_attrs(r, ("contiguity_type", "same_province")), skipped):
            c += 1
    return c


def _add_succession(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,
                    "SELECT old_region_id, new_region_id, succession_type, effective_date "
                    "FROM region_succession"):
        u = node_id("region", r["old_region_id"])
        v = node_id("region", r["new_region_id"])
        if _add_edge_safe(G, u, v, "SUCCEEDED_BY",
                          _clean_attrs(r, ("succession_type", "effective_date")), skipped):
            c += 1
    return c


def _add_contains(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,
                    "SELECT region_id, parent_region FROM regions "
                    "WHERE parent_region IS NOT NULL"):
        u = node_id("region", r["parent_region"])
        v = node_id("region", r["region_id"])
        if _add_edge_safe(G, u, v, "CONTAINS", {}, skipped):
            c += 1
    return c


def _add_similarity(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,
                    "SELECT src_id, dst_id, cosine_sim, rank, model_name "
                    "FROM similarity_edges"):
        u = node_id("ordinance", r["src_id"])
        v = node_id("ordinance", r["dst_id"])
        attrs = _clean_attrs(r, ("rank", "model_name"),
                             extra={"weight": r.get("cosine_sim"),
                                    "cosine_sim": r.get("cosine_sim")})
        if _add_edge_safe(G, u, v, "SIMILAR_TO", attrs, skipped):
            c += 1
    return c


def _add_in_category(conn, G, skipped) -> int:
    c = 0
    for r in _fetch(conn,

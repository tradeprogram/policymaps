"""policymap.collectors.ordin_bulk — 전국 자치법규 전수 메타 수집 + 재개 가능 본문 수집기.

law.py(collect_ordinances)는 지자체 파티션(org/sborg) 단위 증분 수집기다. 반면 이 모듈은
**전국 전수 백필(backfill)** 을 담당한다.

설계 근거 [실측 2026-08-19]:
  * lawSearch.do(target=ordin) 는 query 없이도 knd 별 전건 페이징을 지원한다.
    knd=30001(조례) totalCnt=132,102 / knd=30002(규칙) totalCnt=27,351.
    display=100 기준 page 1322 / 274 까지 정상 응답, 그 다음 page 는 빈 배열(0건).
    → 지자체 파티션 순회 없이 1,596 콜로 전국 메타 전수 확보 가능(콜당 ~1.0초).
  * 목록 응답만으로 자치법규명·지자체기관명·공포일자·시행일자·제개정구분·분야·MST 를
    모두 얻는다 → 전국 격차/확산 분석은 **메타만으로 가능**. 이것이 1순위.
  * 본문(lawService.do target=ordin)은 콜당 ~0.91초 · 전수 159,453건 ≈ 40시간(직렬).
    → 우선순위 큐 + 워터마크로 재개 가능한 점진 수집기로 만들고 세션마다 조금씩 채운다.

공개 API:
    collect_all_metadata(http, cfg, conn, *, knds=("30001","30002"), resume=True, ...) -> dict
    collect_bodies(http, cfg, conn, *, limit, priority="recent", ...) -> dict
    progress(conn) -> dict
    build_region_index(conn) -> dict[str, str]
    match_region(index, org_name) -> str | None

워터마크(db.py 규율: 파티션 완전 영속화 후에만 커서 전진):
    source='ordin_meta', scope=f'knd:{knd}'   cursor='page:{완료페이지}|total:{totalCnt}'
    source='ordin_body', scope=f'priority:{priority}'
                                              cursor='done:{누적}|last:{ordinance_id}|ts:{...}'

규율(CONTRACTS.md):
  * 코어는 표준라이브러리만(선택적 import + 폴백). 파서(parsers.article)는 지연 import.
  * 저장은 db.upsert/upsert_many + db.advance_cursor. 하드삭제 금지.
  * 전수 백필은 **change_log 를 발행하지 않는다**(기준선 스냅샷 13만행 → 체인지피드 오염).
    증분 이벤트는 law.collect_ordinances 가 담당. emit_changes=True 로 강제 가능.
  * 본문 이미 확보한 행(verification_status='source-linked')의 article_count/content_hash/
    department/phone 은 메타 upsert 가 절대 덮지 않는다(메타 row 에 해당 컬럼 부재).

CLI(재개용):
    python -m policymap.collectors.ordin_bulk meta
    python -m policymap.collectors.ordin_bulk bodies --limit 3000 --workers 3
    python -m policymap.collectors.ordin_bulk progress
"""
from __future__ import annotations

import math
import re
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from typing import Any, Callable, Iterable, Optional, Sequence

from .. import db
from ..util import (
    NotFound,
    PermanentError,
    compact,
    content_hash,
    get_logger,
    now_kst_iso,
)
from .law import _KND_TO_KIND, ordin_body, ordin_list, ordinance_row_from_list

_log = get_logger("policymap.collectors.ordin_bulk")

META_SOURCE = "ordin_meta"
BODY_SOURCE = "ordin_body"

_DISPLAY = 100
_META_BATCH = 500          # 배치 커밋 단위(WAL 동시쓰기 배려: 긴 트랜잭션 금지)
_BODY_BATCH = 50
_MAX_PAGES = 4000          # 무한루프 방지 상한(display=100 → 40만건 여유)
_PAGE_RETRY = 2            # HttpClient 자체 재시도 이후의 페이지 단위 추가 재시도

# 본문 수집 대상에서 제외할 verification_status
_BODY_DONE = "source-linked"
_BODY_MISSING = "body-missing"     # 본문 API 가 정상적으로 '없음'을 반환(재시도 무의미)
_META_ONLY = "needs-review"        # law.py 와 동일 어휘(메타만 확보)

_MISSING_ORG_LOG_CAP = 40


# --------------------------------------------------------------------------- #
# 지자체기관명 → regions 매칭
# --------------------------------------------------------------------------- #
_OLD_PREFIX_RE = re.compile(r"\(\s*구\s*\)")


def build_region_index(conn) -> dict[str, str]:
    """regions.full_name/name → region_id 색인.

    폐지·통합 지역도 담되 **활성 행이 나중에 덮어쓰도록** 정렬한다(동명 충돌 시 활성 우선).
    키는 원문과 compact(공백·낫표·가운뎃점 제거) 두 형태 모두 등록.
    """
    index: dict[str, str] = {}
    rows = db.fetchall(
        conn,
        "SELECT region_id, name, full_name, level, status FROM regions "
        "ORDER BY CASE WHEN status IS NULL OR status='active' THEN 1 ELSE 0 END, level",
    )
    for r in rows:
        rid = r["region_id"]
        for key in (r.get("full_name"), r.get("name") if r.get("level") == 1 else None):
            if not key:
                continue
            index[str(key).strip()] = rid
            index[compact(key)] = rid
    return index


def match_region(index: dict[str, str], org_name: Optional[str]) -> Optional[str]:
    """지자체기관명 → region_id. exact full_name 우선 + '(구)' 접두 제거 폴백.

    매칭 실패(교육청·미등재 기관 등)는 None — regions 스텁을 만들지 않는다
    (스파인 오염 방지). org_name 은 ordinances 에 그대로 보존되므로 사후 매핑 가능.
    """
    if not org_name:
        return None
    s = str(org_name).strip()
    for cand in (s, _OLD_PREFIX_RE.sub("", s).strip()):
        if not cand:
            continue
        rid = index.get(cand) or index.get(compact(cand))
        if rid:
            return rid
    return None


# --------------------------------------------------------------------------- #
# 메타 upsert (본문 컬럼 무보존 규율)
# --------------------------------------------------------------------------- #
_PREFETCH_COLS = (
    "ordinance_id", "name", "org_name", "ord_kind", "category_field", "enacted_on",
    "promulgation_no", "effective_on", "rr_cls_cd", "official_url", "local_tier",
    "enacted_by", "ord_id", "region_id", "status", "repealed_on", "verification_status",
)
_COMPARE_COLS = (
    "name", "org_name", "ord_kind", "category_field", "enacted_on", "promulgation_no",
    "effective_on", "rr_cls_cd", "official_url", "local_tier", "enacted_by", "ord_id",
    "region_id", "status",
)


def _norm(v: Any) -> str:
    return "" if v is None else str(v)


def _prefetch_existing(conn, ids: Sequence[str]) -> dict[str, dict]:
    """배치 PK 들의 현재 상태 선조회(무변경 판정 + 본문 상태 보존용)."""
    out: dict[str, dict] = {}
    cols = ", ".join(_PREFETCH_COLS)
    for i in range(0, len(ids), 400):  # SQLite 변수 상한 여유
        chunk = ids[i:i + 400]
        ph = ",".join("?" for _ in chunk)
        for r in db.fetchall(
            conn, f"SELECT {cols} FROM ordinances WHERE ordinance_id IN ({ph})", chunk
        ):
            out[r["ordinance_id"]] = r
    return out


def _flush_meta_batch(conn, rows: list[dict], res: dict) -> None:
    """메타 배치 upsert(호출부가 db.tx 로 감싼다). 무변경은 스킵."""
    if not rows:
        return
    existing = _prefetch_existing(conn, [r["ordinance_id"] for r in rows])
    for row in rows:
        ex = existing.get(row["ordinance_id"])
        if ex is not None:
            # (1) 본문 확보 상태 보존 — 메타 백필이 source-linked 를 되돌리면 안 됨
            if ex.get("verification_status") in (_BODY_DONE, _BODY_MISSING):
                row["verification_status"] = ex["verification_status"]
            # (2) region_id 미매칭 시 기존 매핑 유지(NULL 로 덮지 않음)
            if row.get("region_id") is None and ex.get("region_id"):
                row["region_id"] = ex["region_id"]
            # (3) 툼스톤(superseded) 되돌리기 금지
            if ex.get("status") == "superseded" and row.get("status") == "active":
                row["status"] = "superseded"
                row["repealed_on"] = ex.get("repealed_on")
            if all(_norm(row.get(k)) == _norm(ex.get(k)) for k in _COMPARE_COLS):
                res["unchanged"] += 1
                continue
        action = db.upsert(conn, "ordinances", row, "ordinance_id")
        res[action] += 1
        res["changed"] += 1


def _parse_page_cursor(cursor: Optional[str]) -> int:
    """'page:1234|total:132102' → 1234(완료 페이지). 파싱 실패 시 0."""
    if not cursor:
        return 0
    for part in str(cursor).split("|"):
        if part.startswith("page:"):
            try:
                return int(part[5:])
            except ValueError:
                return 0
    return 0


def _empty_result() -> dict:
    return {"inserted": 0, "updated": 0, "unchanged": 0, "changed": 0,
            "errors": 0, "rows_seen": 0, "calls": 0, "status": "ok"}


def _finalize_status(res: dict) -> None:
    ok_rows = res["inserted"] + res["updated"] + res["unchanged"]
    if res["errors"] and ok_rows == 0:
        res["status"] = "error"
    elif res["errors"] or res.get("stopped"):
        res["status"] = "partial"
    else:
        res["status"] = "ok"


# --------------------------------------------------------------------------- #
# 1) 전국 메타데이터 전수 수집
# --------------------------------------------------------------------------- #
def collect_all_metadata(
    http,
    cfg,
    conn,
    *,
    knds: Iterable[str] = ("30001", "30002"),
    resume: bool = True,
    max_calls: Optional[int] = None,
    batch_size: int = _META_BATCH,
    run_id: Optional[str] = None,
    log_every: int = 25,
    on_progress: Optional[Callable[[dict], None]] = None,
) -> dict:
    """query 없는 knd별 전건 페이징으로 전국 자치법규 메타를 ordinances 에 적재.

    본문은 받지 않는다(article_count/content_hash 미기입 → collect_bodies 대상).
    page 커서를 watermark(source='ordin_meta', scope=f'knd:{knd}') 에 배치 커밋마다
    저장하므로 중단 시 다음 페이지부터 재개된다(resume=True).

    max_calls: 이 호출에서 소비할 ordin_list 콜 상한(예산 통제). 초과 시 status='partial'.
    반환: {inserted, updated, unchanged, changed, errors, rows_seen, calls, status,
           by_knd:{knd:{...}}, unmatched_org:{org_name:cnt}}
    """
    cfg.require("law_oc")
    res = _empty_result()
    res["by_knd"] = {}
    res["unmatched_org"] = {}
    res["failed_pages"] = []
    index = build_region_index(conn)
    started = time.monotonic()

    for knd in knds:
        knd = str(knd)
        scope = f"knd:{knd}"
        wm = db.get_watermark(conn, META_SOURCE, scope) if resume else None
        page = _parse_page_cursor(wm.get("cursor") if wm else None) + 1
        kres = {"pages": 0, "rows": 0, "total": 0, "start_page": page, "errors": 0}
        res["by_knd"][knd] = kres
        buf: list[dict] = []
        last_page_done = page - 1
        total = 0
        stopped = False

        while page <= _MAX_PAGES:
            if max_calls is not None and res["calls"] >= max_calls:
                res["stopped"] = "max_calls"
                stopped = True
                break
            items: list[dict] = []
            err: Optional[Exception] = None
            for attempt in range(_PAGE_RETRY + 1):
                try:
                    res["calls"] += 1
                    total, items = ordin_list(http, cfg, knd=knd,
                                              display=_DISPLAY, page=page)
                    err = None
                    break
                except NotFound:
                    items, err = [], None
                    break
                except PermanentError:
                    raise
                except Exception as exc:  # 네트워크/파싱 실패 → 페이지 단위 재시도
                    err = exc
                    if attempt < _PAGE_RETRY:
                        time.sleep(1.0 * (attempt + 1))
            if err is not None:
                res["errors"] += 1
                kres["errors"] += 1
                res["failed_pages"].append(f"{knd}:{page}")
                _log.warning("ordin_list 실패 knd=%s page=%s: %s", knd, page, err)
                page += 1
                continue
            if not items:
                break

            kres["total"] = total or kres["total"]
            for item in items:
                res["rows_seen"] += 1
                kres["rows"] += 1
                org = item.get("지자체기관명")
                region_id = match_region(index, org)
                if region_id is None and org:
                    res["unmatched_org"][org] = res["unmatched_org"].get(org, 0) + 1
                row = ordinance_row_from_list(item, region_id, knd, cfg)
                if row is None:
                    continue
                buf.append(row)
            kres["pages"] += 1
            last_page_done = page

            if len(buf) >= batch_size:
                _commit_meta(conn, buf, res, scope, last_page_done, total, run_id)
                buf = []
            if log_every and kres["pages"] % log_every == 0:
                pages_total = math.ceil(total / _DISPLAY) if total else 0
                _log.info(
                    "[meta knd=%s] page %d/%s rows=%d ins=%d upd=%d unc=%d err=%d %.1fs",
                    knd, page, pages_total or "?", kres["rows"], res["inserted"],
                    res["updated"], res["unchanged"], res["errors"],
                    time.monotonic() - started,
                )
                if on_progress:
                    on_progress(dict(res))
            page += 1

        if buf:
            _commit_meta(conn, buf, res, scope, last_page_done, total, run_id)
        kres["end_page"] = last_page_done
        if stopped:
            break

    _finalize_status(res)
    if res["failed_pages"]:
        for knd, kres in res["by_knd"].items():
            if not kres.get("errors"):
                continue
            bad = [p for p in res["failed_pages"] if p.startswith(f"{knd}:")]
            db.mark_partition_status(
                conn, META_SOURCE, f"knd:{knd}", "partial",
                note="failed_pages=" + ",".join(bad[:50]),
            )
        conn.commit()
    res["elapsed_sec"] = round(time.monotonic() - started, 1)
    return res


def _commit_meta(conn, buf: list[dict], res: dict, scope: str,
                 page_done: int, total: int, run_id) -> None:
    """배치 영속화 후에만 커서 전진(db.py advance_cursor 규율)."""
    with db.tx(conn):
        _flush_meta_batch(conn, buf, res)
        db.advance_cursor(
            conn, META_SOURCE, scope, f"page:{page_done}|total:{total}",
            status="ok", changed=res["changed"], rows_seen=res["rows_seen"],
            run_id=run_id,
        )


# --------------------------------------------------------------------------- #
# 2) 본문 점진 수집(재개 가능)
# --------------------------------------------------------------------------- #
_PENDING_WHERE = (
    "(article_count IS NULL OR article_count = 0) "
    f"AND COALESCE(verification_status,'') NOT IN ('{_BODY_DONE}','{_BODY_MISSING}') "
    "AND COALESCE(status,'active') <> 'superseded'"
)

_PRIORITY_ORDER = {
    "recent": "COALESCE(enacted_on,'') DESC, mst DESC",
    "oldest": "COALESCE(enacted_on,'') ASC, mst ASC",
}


def _select_pending(conn, *, limit: int, priority: str,
                    knds: Optional[Iterable[str]] = None,
                    keywords: Optional[Sequence[str]] = None) -> list[dict]:
    """본문 미수집 자치법규를 우선순위대로 선택.

    priority:
      'recent'  최근 공포일 우선(기본) — 현행성 높은 조례부터
      'oldest'  오래된 것부터
      'region'  지자체 라운드로빈(커버리지 극대화; window function 미지원 시 recent 폴백)
      'category' keywords 자치법규명 부분일치 우선(없으면 recent 폴백)
    """
    where = _PENDING_WHERE
    params: list[Any] = []
    if knds:
        kinds = [_KND_TO_KIND.get(str(k), str(k)) for k in knds]
        where += " AND ord_kind IN (" + ",".join("?" for _ in kinds) + ")"
        params.extend(kinds)
    if priority == "category" and keywords:
        where += " AND (" + " OR ".join("name LIKE ?" for _ in keywords) + ")"
        params.extend(f"%{k}%" for k in keywords)

    if priority == "region":
        sql = (
            "SELECT ordinance_id, mst, name, region_id, org_name FROM ("
            "  SELECT ordinance_id, mst, name, region_id, org_name,"
            "         ROW_NUMBER() OVER (PARTITION BY COALESCE(region_id,org_name,'?')"
            "                            ORDER BY COALESCE(enacted_on,'') DESC) AS rn"
            f"  FROM ordinances WHERE {where}"
            ") ORDER BY rn, COALESCE(region_id,'') LIMIT ?"
        )
        try:
            return db.fetchall(conn, sql, params + [limit])
        except Exception as exc:  # SQLite < 3.25 등
            _log.warning("priority='region' 미지원(%s) → 'recent' 폴백", exc)
            priority = "recent"

    order = _PRIORITY_ORDER.get(priority, _PRIORITY_ORDER["recent"])
    sql = (f"SELECT ordinance_id, mst, name, region_id, org_name FROM ordinances "
           f"WHERE {where} ORDER BY {order} LIMIT ?")
    return db.fetchall(conn, sql, params + [limit])


class _Gate:
    """스레드 안전 레이트 게이트(workers>1 일 때만 사용). 토큰버킷 근사."""

    def __init__(self, qps: float):
        self.min_interval = 1.0 / qps if qps and qps > 0 else 0.0
        self._lock = threading.Lock()
        self._next = 0.0

    def wait(self) -> None:
        if self.min_interval <= 0:
            return
        with self._lock:
            now = time.monotonic()
            slot = max(now, self._next)
            self._next = slot + self.min_interval
        delay = slot - now
        if delay > 0:
            time.sleep(delay)


def _article_parser():
    """parsers.article 지연 로드(law.py 와 동일 규율 — 부재 시 폴백)."""
    try:
        from ..parsers import article as _a  # type: ignore
        return _a
    except Exception:  # pragma: no cover
        return None


def _save_articles(conn, jomun: list[dict], ordinance_id: str) -> int:
    ap = _article_parser()
    if ap is None or not hasattr(ap, "parse_ordinance_articles") \
            or not hasattr(ap, "save_articles"):
        return 0
    try:
        rows = ap.parse_ordinance_articles(jomun, ordinance_id)
        if not rows:
            return 0
        r = ap.save_articles(conn, rows, table="ordinance_articles")
        return int(r.get("inserted", 0)) + int(r.get("updated", 0))
    except Exception as exc:  # pragma: no cover - 파서 스키마 편차 방어
        _log.warning("자치법규 조문 파싱 스킵(%s): %s", ordinance_id, exc)
        return 0


def _articles_text(jomun: list[dict]) -> str:
    parts = []
    for j in jomun or []:
        if not isinstance(j, dict):
            continue
        c = j.get("조내용")
        if isinstance(c, list):
            parts.append(" ".join(str(x) for x in c))
        elif c:
            parts.append(str(c))
    return "\n".join(parts)


def _fetch_one(http, cfg, mst: str, gate: Optional[_Gate]) -> tuple[str, Any, Any]:
    """('ok', base, jomun) | ('missing', None, None) | ('error', exc, None)."""
    if gate is not None:
        gate.wait()
    try:
        base, jomun = ordin_body(http, cfg, mst)
        return "ok", base, jomun
    except NotFound:
        return "missing", None, None
    except PermanentError:
        raise
    except Exception as exc:
        return "error", exc, None


def collect_bodies(
    http,
    cfg,
    conn,
    *,
    limit: int,
    priority: str = "recent",
    knds: Optional[Iterable[str]] = None,
    keywords: Optional[Sequence[str]] = None,
    workers: int = 1,
    qps: Optional[float] = None,
    batch_size: int = _BODY_BATCH,
    run_id: Optional[str] = None,
    log_every: int = 200,
    on_progress: Optional[Callable[[dict], None]] = None,
) -> dict:
    """본문 미수집 자치법규를 우선순위대로 limit 건 수집 → ordinance_articles 적재.

    성공: article_count=len(조[]) · content_hash · department/phone · verification_status
          ='source-linked'.  정상적 없음(NotFound): 'body-missing' 으로 마킹해 재선택 제외.
    워터마크 source='ordin_body', scope=f'priority:{priority}' 에 누적 진행 기록.
    재개는 자연스럽다 — 이미 본문을 받은 행은 선택 쿼리에서 자동 제외된다.
    """
    cfg.require("law_oc")
    res = _empty_result()
    res["missing"] = 0
    res["articles"] = 0
    scope = f"priority:{priority}"
    gate = _Gate(qps if qps is not None else getattr(cfg, "rate_limit_qps", 5.0)) \
        if workers > 1 else None
    started = time.monotonic()

    targets = _select_pending(conn, limit=limit, priority=priority,
                              knds=knds, keywords=keywords)
    res["selected"] = len(targets)
    if not targets:
        res["status"] = "ok"
        return res

    wm = db.get_watermark(conn, BODY_SOURCE, scope) or {}
    done_total = 0
    for part in str(wm.get("cursor") or "").split("|"):
        if part.startswith("done:"):
            try:
                done_total = int(part[5:])
            except ValueError:
                done_total = 0

    last_id = ""
    for start in range(0, len(targets), batch_size):
        chunk = targets[start:start + batch_size]
        fetched: list[tuple[dict, tuple[str, Any, Any]]] = []
        if workers > 1:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = [(t, ex.submit(_fetch_one, http, cfg, t["mst"], gate))
                        for t in chunk]
                for t, f in futs:
                    fetched.append((t, f.result()))
        else:
            for t in chunk:
                fetched.append((t, _fetch_one(http, cfg, t["mst"], None)))
        res["calls"] += len(chunk)

        with db.tx(conn):
            for t, (kind, a, b) in fetched:
                oid = t["ordinance_id"]
                res["rows_seen"] += 1
                if kind == "error":
                    res["errors"] += 1
                    _log.warning("본문 수집 실패(%s): %s", oid, a)
                    continue
                if kind == "missing":
                    res["missing"] += 1
                    conn.execute(
                        "UPDATE ordinances SET article_count=0, verification_status=?, "
                        "updated_at=? WHERE ordinance_id=?",
                        (_BODY_MISSING, now_kst_iso(), oid),
                    )
                    last_id = oid
                    continue
                base, jomun = a or {}, b or []
                upd: dict[str, Any] = {
                    "article_count": len(jomun),
                    "content_hash": content_hash(_articles_text(jomun) or t["name"]),
                    "verification_status": _BODY_DONE,
                    "updated_at": now_kst_iso(),
                }
                if isinstance(base, dict):
                    if base.get("담당부서명"):
                        upd["department"] = base.get("담당부서명")
                    if base.get("전화번호"):
                        upd["phone"] = base.get("전화번호")
                sets = ", ".join(f"{k}=?" for k in upd)
                conn.execute(
                    f"UPDATE ordinances SET {sets} WHERE ordinance_id=?",
                    list(upd.values()) + [oid],
                )
                if jomun:
                    res["articles"] += _save_articles(conn, jomun, oid)
                res["updated"] += 1
                res["changed"] += 1
                last_id = oid
            done_total += len(chunk)
            db.advance_cursor(
                conn, BODY_SOURCE, scope,
                f"done:{done_total}|last:{last_id}|ts:{now_kst_iso()}",
                status="ok", changed=res["changed"], rows_seen=res["rows_seen"],
                run_id=run_id,
            )

        if log_every and res["rows_seen"] % log_every < batch_size:
            _log.info("[body %s] %d/%d ok=%d missing=%d err=%d arts=%d %.1fs",
                      priority, res["rows_seen"], len(targets), res["updated"],
                      res["missing"], res["errors"], res["articles"],
                      time.monotonic() - started)
            if on_progress:
                on_progress(dict(res))

    _finalize_status(res)
    res["elapsed_sec"] = round(time.monotonic() - started, 1)
    return res


# --------------------------------------------------------------------------- #
# 3) 진행률 리포트
# --------------------------------------------------------------------------- #
def progress(conn) -> dict:
    """메타 수집률 · 본문 수집률 · 지자체 커버리지."""
    out: dict[str, Any] = {}

    # --- 메타 ---
    # ord_kind 버킷: '조례' 포함 → knd 30001, 그 외(규칙·교육규칙·의회규칙…) → 30002
    kind_counts = {r["ord_kind"]: r["n"] for r in db.fetchall(
        conn, "SELECT ord_kind, COUNT(*) AS n FROM ordinances GROUP BY ord_kind")}
    bucket = {"30001": 0, "30002": 0}
    for k, n in kind_counts.items():
        bucket["30001" if "조례" in (k or "") else "30002"] += n

    meta: dict[str, Any] = {"by_knd": {}, "expected_total": 0, "collected_total": 0,
                            "by_ord_kind": kind_counts}
    for knd, label in (("30001", "조례"), ("30002", "규칙류")):
        wm = db.get_watermark(conn, META_SOURCE, f"knd:{knd}") or {}
        expected = 0
        page_done = _parse_page_cursor(wm.get("cursor"))
        for part in str(wm.get("cursor") or "").split("|"):
            if part.startswith("total:"):
                try:
                    expected = int(part[6:])
                except ValueError:
                    expected = 0
        got = bucket[knd]
        meta["by_knd"][knd] = {
            "kind": label, "expected": expected, "collected": got,
            "page_done": page_done, "status": wm.get("status"),
            "pct": round(100.0 * got / expected, 2) if expected else None,
        }
        meta["expected_total"] += expected
        meta["collected_total"] += got
    meta["rows_total"] = db.count(conn, "ordinances")
    meta["meta_only"] = db.count(conn, "ordinances", "verification_status=?",
                                 (_META_ONLY,))
    meta["pct"] = round(100.0 * meta["collected_total"] / meta["expected_total"], 2) \
        if meta["expected_total"] else None
    out["meta"] = meta

    # --- 본문 ---
    total = meta["rows_total"]
    done = db.count(conn, "ordinances", "verification_status=?", (_BODY_DONE,))
    missing = db.count(conn, "ordinances", "verification_status=?", (_BODY_MISSING,))
    pending = db.count(conn, "ordinances", _PENDING_WHERE)
    out["body"] = {
        "total": total, "collected": done, "missing": missing, "pending": pending,
        "pct": round(100.0 * done / total, 2) if total else None,
        "articles": db.count(conn, "ordinance_articles"),
    }

    # --- 지자체 커버리지 ---
    l2_active = db.count(conn, "regions",
                         "level=2 AND (status IS NULL OR status='active')")
    l1_active = db.count(conn, "regions",
                         "level=1 AND (status IS NULL OR status='active')")
    cov2 = db.fetchone(
        conn,
        "SELECT COUNT(DISTINCT o.region_id) AS n FROM ordinances o "
        "JOIN regions r ON r.region_id=o.region_id "
        "WHERE r.level=2 AND (r.status IS NULL OR r.status='active')",
    ) or {"n": 0}
    cov1 = db.fetchone(
        conn,
        "SELECT COUNT(DISTINCT o.region_id) AS n FROM ordinances o "
        "JOIN regions r ON r.region_id=o.region_id "
        "WHERE r.level=1 AND (r.status IS NULL OR r.status='active')",
    ) or {"n": 0}
    body_cov = db.fetchone(
        conn,
        "SELECT COUNT(DISTINCT o.region_id) AS n FROM ordinances o "
        "JOIN regions r ON r.region_id=o.region_id "
        "WHERE r.level=2 AND (r.status IS NULL OR r.status='active') "
        f"AND o.verification_status='{_BODY_DONE}'",
    ) or {"n": 0}
    out["coverage"] = {
        "level2_active": l2_active, "level2_with_ordinance": cov2["n"],
        "level2_pct": round(100.0 * cov2["n"] / l2_active, 2) if l2_active else None,
        "level1_active": l1_active, "level1_with_ordinance": cov1["n"],
        "level2_with_body": body_cov["n"],
        "unmatched_region": db.count(conn, "ordinances", "region_id IS NULL"),
    }
    out["as_of"] = now_kst_iso()
    return out


__all__ = [
    "collect_all_metadata", "collect_bodies", "progress",
    "build_region_index", "match_region",
    "META_SOURCE", "BODY_SOURCE",
]


# --------------------------------------------------------------------------- #
# CLI (재개 실행용)
# --------------------------------------------------------------------------- #
def _main(argv: Optional[list[str]] = None) -> int:  # pragma: no cover - 운영 진입점
    import argparse
    import json

    from ..config import load_config
    from ..util import HttpClient

    ap = argparse.ArgumentParser(prog="policymap.collectors.ordin_bulk")
    ap.add_argument("cmd", choices=("meta", "bodies", "progress"))
    ap.add_argument("--limit", type=int, default=1000)
    ap.add_argument("--priority", default="recent",
                    choices=("recent", "oldest", "region", "category"))
    ap.add_argument("--keywords", default=None, help="쉼표구분(priority=category)")
    ap.add_argument("--knds", default="30001,30002")
    ap.add_argument("--workers", type=int, default=1)
    ap.add_argument("--qps", type=float, default=None)
    ap.add_argument("--max-calls", type=int, default=None)
    ap.add_argument("--no-resume", action="store_true")
    args = ap.parse_args(argv)

    cfg = load_config()
    conn = db.connect()
    if args.cmd == "progress":
        print(json.dumps(progress(conn), ensure_ascii=False, indent=2))
        return 0
    knds = tuple(k.strip() for k in args.knds.split(",") if k.strip())
    with HttpClient(cfg) as http:
        if args.cmd == "meta":
            out = collect_all_metadata(http, cfg, conn, knds=knds,
                                       resume=not args.no_resume,
                                       max_calls=args.max_calls)
        else:
            kws = [k.strip() for k in args.keywords.split(",")] if args.keywords else None
            out = collect_bodies(http, cfg, conn, limit=args.limit,
                                 priority=args.priority, knds=knds,
                                 keywords=kws, workers=args.workers, qps=args.qps)
    if isinstance(out.get("unmatched_org"), dict):  # 상위 20건만 노출
        top = sorted(out["unmatched_org"].items(), key=lambda kv: -kv[1])[:20]
        out["unmatched_org_top"] = dict(top)
        out["unmatched_org_kinds"] = len(out.pop("unmatched_org"))
    print(json.dumps(out, ensure_ascii=False, indent=2, default=str))
    return 0


if __name__ == "__main__":  # pragma: no cover
    raise SystemExit(_main())
